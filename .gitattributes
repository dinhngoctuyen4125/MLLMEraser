* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

*.pdf binary
*.pt  binary

# D_test_U_nondep.json is ~128 MB, over GitHub's 100 MB hard limit.
# Needs `git lfs install` in the clone before these are usable.
data/**/*.json filter=lfs diff=lfs merge=lfs -text
